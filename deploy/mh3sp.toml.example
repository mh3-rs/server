# mh3sp's configuration (README.md, "Configuration"): copy to mh3sp.toml. Every key not set here has its default.

# The address consoles reach this server at (handed out for LMP, FMP and the relay).
external_address = "203.0.113.10"
# The domain the players' patch points the game at (at most 25 characters): `mh3sp patch` lists its DNS records.
domain = "mh3.example.org"
# The support codes' pepper, from the compose secret (never in this file).
secret__file = "/run/secrets/mh3sp"
content_dir = "/opt/mh3sp/content"

# Optional: natneg_strategy, relay_ports, health_address, the ports, tls_dir (default data/tls: the CA, created at the
# first start; back it up with the database).

# Your texts (a sentence each by default; README, "Configuration"):
# name = "My Monster Hunter Tri server"
# announce = "<BODY><CENTER>Welcome to our server!<END>"
# terms = "Play fair and be kind to other hunters."
# guildmaster = "To all hunters:\nthe Arena is open!"
